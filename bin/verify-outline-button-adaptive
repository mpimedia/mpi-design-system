#!/usr/bin/env ruby
# frozen_string_literal: true

# Verifies the theme-adaptive outline-button partial (ISS#183 follow-up).
# `_buttons.scss` re-points each `.btn-outline-#{semantic}`'s RESTING foreground at
# `--bs-#{semantic}-text-emphasis`, the one Bootstrap 5.3 token family in play that
# re-resolves under `data-bs-theme`. Without it every outline variant sits below the
# 4.5:1 AA floor in one colour mode or the other (measured table in the partial).
# This is the compile-level guard; the painted-value proof per mode lives in
# spec/features/outline_button_theme_spec.rb.
#
# It runs against the STANDALONE-compiled fixture (spec/fixtures/scss/
# outline_button_adaptive.scss -> tmp/compat/outline_button.css). The fixture imports
# the partial with neither MPI tokens nor Bootstrap in scope, so a regression to a
# compile-time `$primary` would fail to compile before reaching this script — the file
# arriving here at all proves it is Sass-colour-var-free. This script proves the
# stronger claims a "does the token appear?" grep cannot:
#
#   1. PER-SELECTOR BINDING — each of the six selectors binds `--bs-btn-color` to its
#      OWN semantic's emphasis token. A primary<->danger swap keeps both tokens in the
#      file and passes any presence grep; it reds here.
#   2. EXACT COVERAGE — all six semantics present, and no EXTRA selector. `light`/`dark`
#      are excluded on purpose: both `--bs-light-text-emphasis` and
#      `--bs-dark-text-emphasis` compile to #495057 in light mode, so binding them would
#      erase the distinction between the two variants.
#   3. STRONG NEGATIVE — no declaration may carry a raw colour (hex, rgb()/hsl(), or a
#      CSS named colour) in ANY property. A regression to `--bs-btn-color: #2E75B6` reds
#      as WRONG BINDING *and* RAW COLOUR.
#   4. SCOPE — the partial must not touch border, hover, active or disabled custom
#      properties. Those are deliberately left on the raw semantic hue (border is a
#      non-text boundary at the 3:1 SC 1.4.11 floor, which every semantic clears; hover
#      fills solid and is already AA; disabled is exempt under 1.4.3). Widening the
#      partial silently would change the button's identity colour, so it must be a
#      deliberate, reviewable edit here.
#
# Run via `yarn build:css:compat`. Prove it by breaking it (.claude/rules/frontend.md,
# "prove a new build guard by breaking it"): swap primary's binding to
# var(--bs-danger-text-emphasis) -> WRONG BINDING; set `--bs-btn-color: #2E75B6` ->
# WRONG BINDING + RAW COLOUR; add `--bs-btn-border-color: var(--bs-primary)` -> OUT OF
# SCOPE; drop a semantic from the @each list -> MISSING.

# Two modes, because "the bindings are right" and "the bindings WIN" are different claims
# and the first does not imply the second (both gaps found by external review of f7b5b8f):
#
#   <partial.css>              strict — the standalone partial emits exactly the six rules
#   --cascade <entry.css>      the documented consumer order, with Bootstrap in scope:
#                              assert OUR declaration is the one that wins for each selector
CASCADE = ARGV.delete("--cascade") ? true : false
CSS = ARGV[0] || (CASCADE ? "tmp/compat/outline_button_cascade.css" : "tmp/compat/outline_button.css")

unless File.file?(CSS)
  warn "verify-outline-button-adaptive: #{CSS} not found — compile the fixture first"
  exit 1
end

SEMANTICS = %w[primary secondary success info warning danger].freeze

# Only the resting foreground is in scope. Anything else the partial might emit is a
# scope violation, checked explicitly rather than ignored.
ALLOWED_PROPERTY = "--bs-btn-color"

NAMED_COLOURS = %w[
  red blue green yellow orange purple pink brown black white grey gray cyan magenta
  navy teal olive maroon lime aqua fuchsia silver gold beige ivory khaki coral salmon
  crimson indigo violet turquoise tan plum orchid papayawhip chartreuse
].freeze

css = File.read(CSS)
# Strip comments ONCE, up front, and parse the stripped text in both modes. An at-rule or a
# brace named inside a `/* … */` note is prose, not structure: left in, it was absorbed into
# the following selector and turned a documentation edit into a build failure.
uncommented = css.gsub(%r{/\*.*?\*/}m, "")
errors = []

# ---------------------------------------------------------------------------------
# CASCADE MODE — which declaration actually wins?
#
# With Bootstrap in scope, `.btn-outline-primary` is declared twice: Bootstrap's raw hue
# and ours. Later-and-equal-specificity wins, so the LAST `--bs-btn-color` for a given
# selector is the painted one. Asserting on "a rule exists that binds the var" would pass
# even when Bootstrap's rule comes after ours, which is precisely the import-order
# regression this mode exists to catch.
if CASCADE
  # An unlayered declaration beats a layered one no matter the order, so a layered
  # override is a silent revert. Nothing else in the build sees it.
  # Only a layer that actually contains button rules can revert the fix. The first version
  # rejected ANY `@layer`, so an unrelated `@layer review-utilities { .review-utility {…} }`
  # failed the build (external review, round 3) — a guard that cannot pass legitimate input
  # gets disabled, which is worse than one that is slightly narrower.
  layered_button_rule = uncommented.scan(/@layer[^{]*\{(.*)\}/m).flatten.any? do |body|
    body =~ /\.btn(?:-outline)?[-\s{.:,]/
  end

  if layered_button_rule
    warn "verify-outline-button-adaptive: FAIL (#{CSS})"
    warn "  - CASCADE LAYER: a @layer block contains button rules. Layered declarations LOSE " \
         "to Bootstrap's unlayered ones regardless of source order, so the override silently " \
         "reverts."
    exit 1
  end

  # Parse into ordered (selector, body) rules. Substring-matching the selector is not good
  # enough and was a false pass in the first version of this mode: `.wrapper
  # .btn-outline-primary` CONTAINS `.btn-outline-primary`, so a scoped rule appended after a
  # reverted base rule was read as the winner while the base rule stayed broken.
  rules = uncommented.scan(/([^{}]+)\{([^{}]*)\}/m).map { |sel, body| [ sel.strip, body.strip ] }

  # A selector "is" this element only if one of its comma-separated parts is EXACTLY the
  # class — not a descendant, not a compound.
  targets_exactly = lambda do |selector, want|
    selector.split(",").map(&:strip).any? { |part| part == want }
  end

  declares_btn_colour = ->(body) { body =~ /--bs-btn-color:/ }

  SEMANTICS.each do |semantic|
    want = ".btn-outline-#{semantic}"
    expected = "var(--bs-#{semantic}-text-emphasis)"

    ours_at = nil
    winner = nil

    rules.each_with_index do |(selector, body), index|
      next unless targets_exactly.call(selector, want)

      body.scan(/--bs-btn-color:\s*([^;]+);/).flatten.each do |value|
        winner = value.strip
        ours_at = index
      end
    end

    if winner.nil?
      errors << "MISSING: no --bs-btn-color declared on the bare #{want} selector at all"
      next
    end

    unless winner == expected
      errors << "LOSES THE CASCADE: #{want} is finally painted by #{winner.inspect}, not " \
                "#{expected.inspect}. Import `mpi_design_system/buttons` AFTER Bootstrap."
      next
    end

    # Winning among rules with this exact selector is NOT the same as winning outright.
    # `.btn` has identical specificity (0,1,0), so a LATER `.btn { --bs-btn-color: … }`
    # beats our earlier `.btn-outline-*` rule — a real revert this mode passed at first.
    # Rather than model CSS specificity, reject any later rule that could plausibly reach an
    # outline button. Conservative on purpose: over-rejection costs one reviewed exception,
    # under-rejection is a silent false green.
    # "Could reach an outline button of THIS semantic" — deliberately not "mentions btn".
    # The first version used the looser test and flagged the other five semantics' own
    # rules, which target different elements entirely; the real fixture failed. A guard
    # that cannot pass its own correct input is not conservative, it is broken.
    threatens = lambda do |selector|
      parts = selector.split(",").map(&:strip)
      parts.any? do |part|
        part == ".btn" ||                       # same specificity, applies to every button
          part.include?("btn-outline-#{semantic}") || # scoped/compound form of this one
          part.include?("[class")               # attribute match could catch anything
      end
    end

    later = rules.each_with_index.select do |(selector, body), index|
      index > ours_at && threatens.call(selector) && declares_btn_colour.call(body)
    end

    next if later.empty?

    offenders = later.map { |(selector, _), _| selector }.uniq
    errors << "LATER OVERRIDE: #{want} binds correctly, but #{offenders.length} later rule(s) " \
              "also declare --bs-btn-color and may win: #{offenders.inspect}. " \
              "If one is legitimate, narrow this check deliberately rather than widening it."
  end

  # The fixture above mirrors the README's consumer order. The ENGINE's own entrypoint is a
  # separate file with its own order, shipped to anyone importing `mpi_design_system/application`
  # — and it cannot be compiled standalone here (its bare `@import "bootstrap"` resolves only
  # in a consumer's load path), so it gets a source-order check rather than a compiled one.
  ENTRYPOINT = "app/assets/stylesheets/mpi_design_system/application.scss"
  if File.file?(ENTRYPOINT)
    # Strip comments before scanning: a commented-out `@import "buttons"` is not an import,
    # and the line-oriented first version counted it (external review, round 3).
    entry_src = File.read(ENTRYPOINT).gsub(%r{/\*.*?\*/}m, "").gsub(%r{//[^\n]*}, "")
    # `@use` loads a module just as `@import` does; only matching @import reported a correct
    # `@use`-based entrypoint as missing the import entirely.
    imports = entry_src.scan(/@(?:import|use)\s+["']([^"']+)["']/).flatten

    # The LAST Bootstrap load is the one our override must follow. Taking the FIRST let a
    # second `@import "bootstrap"` AFTER buttons re-declare the raw hue and still pass.
    bootstrap_at = imports.rindex { |i| i[/\bbootstrap\b/] }
    buttons_at = imports.rindex { |i| i[/\bbuttons\b/] }

    if buttons_at.nil?
      errors << "ENTRYPOINT: #{ENTRYPOINT} does not import `buttons` at all — the fix never " \
                "reaches anyone importing the engine stylesheet"
    elsif bootstrap_at.nil?
      errors << "ENTRYPOINT: #{ENTRYPOINT} imports `buttons` but not `bootstrap`; the override " \
                "has nothing to override and the order claim cannot be checked"
    elsif buttons_at < bootstrap_at
      errors << "ENTRYPOINT ORDER: #{ENTRYPOINT} imports `buttons` (position #{buttons_at}) " \
                "BEFORE the LAST `bootstrap` load (position #{bootstrap_at}); Bootstrap's raw " \
                "hue then wins and the AA fix silently reverts"
    end
  else
    # Fail CLOSED. The first version skipped the check when the file was missing and still
    # printed that the entrypoint order was fine — a guard asserting something it never read.
    errors << "ENTRYPOINT MISSING: #{ENTRYPOINT} not found. This guard cannot confirm the " \
              "engine stylesheet imports `buttons` after Bootstrap; run it from the repo root."
  end

  if errors.any?
    warn "verify-outline-button-adaptive: FAIL (#{CSS})"
    errors.each { |e| warn "  - #{e}" }
    exit 1
  end

  puts "outline-button cascade OK: in the documented consumer order, all #{SEMANTICS.size} " \
       ".btn-outline-* are finally painted by their own --bs-<semantic>-text-emphasis; " \
       "the engine entrypoint imports buttons after bootstrap"
  exit 0
end

# ---------------------------------------------------------------------------------
# STRICT MODE — the standalone partial.
#
# Reject at-rules outright rather than parsing into them. The block regex below cannot
# represent nesting, so `@layer { .btn-outline-primary { … } }` would otherwise have its
# INNER rule extracted and pass while the enclosing context silently changed the meaning.
if uncommented =~ /(@[a-z-]+)/i
  warn "verify-outline-button-adaptive: FAIL (#{CSS})"
  warn "  - AT-RULE: #{Regexp.last_match(1).inspect} present. The partial must emit flat rules only; " \
       "an enclosing @layer/@media/@supports changes which declaration wins and this " \
       "parser cannot see it."
  exit 1
end

# Parse `selector { decls }` blocks. The partial emits only flat rules, so a nested or
# at-rule block appearing here is itself a change worth failing on.
blocks = uncommented.scan(/([^{}]+)\{([^{}]*)\}/m).map { |sel, body| [ sel.strip, body.strip ] }

if blocks.empty?
  warn "verify-outline-button-adaptive: FAIL — #{CSS} contains no rules at all"
  exit 1
end

# FAIL CLOSED on anything the parser did not consume. Without this, appending
# `this is not valid CSS` to a valid file passed silently — the scan simply skipped it.
# "Could not parse" must route to reject, not to pass (.claude/rules/testing.md).
residue = uncommented.gsub(/([^{}]+)\{([^{}]*)\}/m, "").strip
unless residue.empty?
  warn "verify-outline-button-adaptive: FAIL (#{CSS})"
  warn "  - UNPARSED: #{residue[0, 120].inspect} lies outside any rule. A guard that cannot " \
       "parse its input must reject it, not ignore it."
  exit 1
end

seen = {}

blocks.each do |selector, body|
  unless selector =~ /\A\.btn-outline-([a-z]+)\z/
    errors << "UNEXPECTED SELECTOR: #{selector.inspect} — the partial should emit only .btn-outline-<semantic> rules"
    next
  end

  semantic = Regexp.last_match(1)
  unless SEMANTICS.include?(semantic)
    errors << "OUT OF SCOPE: #{selector.inspect} — #{semantic.inspect} is not one of #{SEMANTICS.join(', ')}"
    next
  end

  declarations = body.split(";").map(&:strip).reject(&:empty?)

  if declarations.empty?
    errors << "EMPTY RULE: #{selector.inspect} declares nothing — the binding would silently not apply"
    next
  end

  declarations.each do |decl|
    property, value = decl.split(":", 2).map { |s| s.to_s.strip }

    if property != ALLOWED_PROPERTY
      errors << "OUT OF SCOPE: #{selector.inspect} sets #{property.inspect} — only #{ALLOWED_PROPERTY} is in scope " \
                "(border/hover/active/disabled are deliberately left on the raw hue; see _buttons.scss)"
      next
    end

    expected = "var(--bs-#{semantic}-text-emphasis)"
    if value != expected
      errors << "WRONG BINDING: #{selector.inspect} sets #{property} to #{value.inspect}, expected #{expected.inspect}"
    end

    if value =~ /#\h{3,8}\b/ || value =~ /\b(?:rgba?|hsla?)\(/i
      errors << "RAW COLOUR: #{selector.inspect} #{property} carries a literal colour in #{value.inspect}"
    end

    if value =~ /\b(?:#{NAMED_COLOURS.join('|')})\b/i
      errors << "RAW COLOUR: #{selector.inspect} #{property} carries a named colour in #{value.inspect}"
    end

    seen[semantic] = true
  end
end

missing = SEMANTICS - seen.keys
errors << "MISSING: no correct #{ALLOWED_PROPERTY} binding for #{missing.join(', ')}" unless missing.empty?

# EXACTLY six rules, each semantic once. Without this a seventh duplicate `.btn-outline-primary`
# rule passed while the summary still claimed "all 6" — the residue check accepts anything
# rule-SHAPED, so it could not see the duplication (external review, round 3). A duplicate is
# not harmless: it is how a second, differing binding hides in plain sight.
selectors = blocks.map(&:first)
if selectors.length != SEMANTICS.length
  errors << "RULE COUNT: #{selectors.length} rules emitted, expected exactly #{SEMANTICS.length} " \
            "(one per semantic): #{selectors.inspect}"
end
duplicates = selectors.tally.select { |_, n| n > 1 }.keys
errors << "DUPLICATE RULE(S): #{duplicates.inspect} declared more than once" unless duplicates.empty?

if errors.any?
  warn "verify-outline-button-adaptive: FAIL (#{CSS})"
  errors.each { |e| warn "  - #{e}" }
  exit 1
end

puts "outline-button adaptive OK: all #{SEMANTICS.size} .btn-outline-* bind --bs-btn-color to their own " \
     "--bs-<semantic>-text-emphasis, no raw colour, nothing out of scope"
